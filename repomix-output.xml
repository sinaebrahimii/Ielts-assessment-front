"use client";

import React, { useState } from "react";
import { motion, AnimatePresence } from "motion/react";
import {
  Bot,
  Cpu,
  Sparkles,
  ShieldCheck,
  Terminal,
  Flame,
  CheckCircle2,
} from "lucide-react";

interface Agent {
  id: string;
  name: string;
  role: string;
  enRole: string;
  color: string;
  accentBorder: string;
  badgeBg: string;
  description: string;
  liveOutput: string;
  metrics: { label: string; val: string }[];
}

const agents: Agent[] = [
  {
    id: "orchestrator",
    name: "Master Examiner Agent",
    role: "سنجش معیار Task Response و مدیریت بازخورد",
    enRole: "TR & Flow Evaluator",
    color: "#a855f7",
    accentBorder: "border-purple-500/40",
    badgeBg: "bg-purple-500/10 text-purple-300 border-purple-500/30",
    description:
      "تطابق کامل ساختار استدلال با صورت سوال، انسجام ایده و بررسی پاسخگویی کامل به تمام بخش‌های موضوع تسک.",
    liveOutput:
      "Agent[TaskResponse]:: Analysis finished. Topic coverage: 98.4%. Counter-arguments resolved cleanly.",
    metrics: [
      { label: "Target Band", val: "8.5+" },
      { label: "Response Latency", val: "320ms" },
    ],
  },
  {
    id: "linguist",
    name: "Lexical & Collocation Agent",
    role: "تحلیل دایره لغات تخصصی و ترکیب‌های طبیعی",
    enRole: "Lexical Resource Expert",
    color: "#38bdf8",
    accentBorder: "border-sky-500/40",
    badgeBg: "bg-sky-500/10 text-sky-300 border-sky-500/30",
    description:
      "جایگزینی عبارات تکراری و ابتدایی با Academic Collocations و اصطلاحات متناسب با سطح Band 8+.",
    liveOutput:
      "Agent[Lexical]:: Replaced 'important problem' with 'pressing conundrum'. Collocation naturalness 94%.",
    metrics: [
      { label: "Vocabulary Density", val: "C1/C2" },
      { label: "Uniqueness", val: "91%" },
    ],
  },
  {
    id: "grammar",
    name: "Grammar & Syntax Sentinel",
    role: "ردیابی ریزساختارهای گرامری و تنوع جملات",
    enRole: "GRA Syntactic Engine",
    color: "#34d399",
    accentBorder: "border-emerald-500/40",
    badgeBg: "bg-emerald-500/10 text-emerald-300 border-emerald-500/30",
    description:
      "سنجش تعادل میان Complex Sentences و Compound Sentences به همراه حذف خطاهای ریز گرامری و نشانه‌گذاری.",
    liveOutput:
      "Agent[Grammar]:: Inversion verified ('Rarely do we witness...'). Zero punctuation slippage.",
    metrics: [
      { label: "Syntax Variety", val: "Complex 76%" },
      { label: "Accuracy", val: "99.8%" },
    ],
  },
];

export function AgentArchitectureSection() {
  const [selectedAgent, setSelectedAgent] = useState<Agent>(agents[0]);

  return (
    <section
      dir="rtl"
      className="w-full relative py-20 px-4 sm:px-6 md:px-12 bg-bg-dark font-vazirmatn overflow-hidden border-t border-white/5"
    >
      {/* Dynamic ambient background glow */}
      <div
        className="absolute top-1/2 right-1/4 -translate-y-1/2 w-96 h-96 rounded-full opacity-20 blur-[130px] pointer-events-none transition-colors duration-700"
        style={{ backgroundColor: selectedAgent.color }}
      />

      <div className="max-w-6xl mx-auto relative z-10">
        {/* Section Header */}
        <div className="text-center max-w-3xl mx-auto mb-14 space-y-4">
          <motion.div
            initial={{ opacity: 0, y: 15 }}
            whileInView={{ opacity: 1, y: 0 }}
            viewport={{ once: true }}
            className="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-purple-500/30 bg-purple-950/30 text-purple-300 text-xs font-semibold"
          >
            <Bot size={15} className="animate-pulse" />
            <span>معماری چندعاملی تخصصی (Multi-Agent System)</span>
          </motion.div>

          <motion.h2
            initial={{ opacity: 0, y: 15 }}
            whileInView={{ opacity: 1, y: 0 }}
            viewport={{ once: true }}
            transition={{ delay: 0.1 }}
            className="text-2xl sm:text-4xl font-black text-white leading-tight"
          >
            نه یک پرامپت ساده، بلکه ارتشی از{" "}
            <span className="bg-gradient-to-r from-purple-400 via-pink-400 to-indigo-300 bg-clip-text text-transparent">
              ایجنت‌های مستقل ارزیاب
            </span>
          </motion.h2>

          <motion.p
            initial={{ opacity: 0, y: 15 }}
            whileInView={{ opacity: 1, y: 0 }}
            viewport={{ once: true }}
            transition={{ delay: 0.2 }}
            className="text-sm sm:text-base text-neutral-400 leading-relaxed"
          >
            هر معیار چهارگانه آیلتس توسط یک ایجنت هوشمند و متمرکز پردازش می‌شود
            تا نمره نهایی شما کاملاً دقیق، مستند و قابل اتکا باشد.
          </motion.p>
        </div>

        {/* Agent Cards Grid */}
        <div className="grid grid-cols-1 md:grid-cols-3 gap-5 mb-10">
          {agents.map((agent) => {
            const isSelected = selectedAgent.id === agent.id;
            return (
              <motion.div
                key={agent.id}
                whileHover={{ y: -4, transition: { duration: 0.2 } }}
                onClick={() => setSelectedAgent(agent)}
                className={`cursor-pointer relative rounded-2xl p-6 transition-all duration-300 backdrop-blur-md border ${
                  isSelected
                    ? `${agent.accentBorder} bg-gradient-to-b from-white/[0.08] to-white/[0.02] shadow-[0_0_25px_rgba(0,0,0,0.5)]`
                    : "border-white/5 bg-white/[0.02] hover:border-white/15"
                }`}
              >
                {/* Active Indicator Pillar */}
                {isSelected && (
                  <motion.div
                    layoutId="activePill"
                    className="absolute top-0 right-6 left-6 h-0.5 rounded-full"
                    style={{ backgroundColor: agent.color }}
                  />
                )}

                <div className="flex items-center justify-between mb-4">
                  <div
                    className="p-3 rounded-xl border flex items-center justify-center"
                    style={{
                      backgroundColor: `${agent.color}15`,
                      borderColor: `${agent.color}35`,
                      color: agent.color,
                    }}
                  >
                    <Cpu size={22} />
                  </div>
                  <span
                    className={`text-[11px] px-2.5 py-0.5 rounded-full border font-mono tracking-wider ${agent.badgeBg}`}
                  >
                    {agent.enRole}
                  </span>
                </div>

                <h3 className="text-lg font-bold text-neutral-100 mb-1">
                  {agent.name}
                </h3>
                <p className="text-xs text-neutral-400 leading-relaxed min-h-[48px]">
                  {agent.role}
                </p>

                <div className="mt-4 pt-4 border-t border-white/5 flex items-center justify-between text-xs text-neutral-400">
                  <span className="flex items-center gap-1.5">
                    <span className="relative flex h-2 w-2">
                      <span
                        className="animate-ping absolute inline-flex h-full w-full rounded-full opacity-75"
                        style={{ backgroundColor: agent.color }}
                      ></span>
                      <span
                        className="relative inline-flex rounded-full h-2 w-2"
                        style={{ backgroundColor: agent.color }}
                      ></span>
                    </span>
                    Agent Active
                  </span>
                  <span className="text-neutral-500 font-mono">
                    Telemetry OK
                  </span>
                </div>
              </motion.div>
            );
          })}
        </div>

        {/* Live Agent Terminal Console Display */}
        <motion.div
          dir="ltr"
          layout
          className="w-full rounded-2xl border border-white/10 bg-black/60 backdrop-blur-xl p-5 sm:p-6 text-left shadow-2xl relative overflow-hidden"
        >
          <div className="flex items-center justify-between pb-4 mb-4 border-b border-white/10">
            <div className="flex items-center gap-2">
              <Terminal size={18} className="text-neutral-400" />
              <span className="text-xs font-mono text-neutral-400 uppercase tracking-wider">
                Agent Inference Stream // {selectedAgent.id}
              </span>
            </div>
            <div className="flex gap-1.5">
              <span className="w-2.5 h-2.5 rounded-full bg-red-500/60 inline-block" />
              <span className="w-2.5 h-2.5 rounded-full bg-yellow-500/60 inline-block" />
              <span className="w-2.5 h-2.5 rounded-full bg-emerald-500/60 inline-block" />
            </div>
          </div>

          <div className="grid grid-cols-1 md:grid-cols-3 gap-6 items-center">
            <div className="md:col-span-2 space-y-3 font-mono text-xs sm:text-sm">
              <p className="text-neutral-500 leading-relaxed">
                <span className="text-neutral-300">{`>`}</span> System: Agent
                handoff initiated for essay tokens...
              </p>
              <AnimatePresence mode="wait">
                <motion.p
                  key={selectedAgent.id}
                  initial={{ opacity: 0, x: -10 }}
                  animate={{ opacity: 1, x: 0 }}
                  exit={{ opacity: 0, x: 10 }}
                  transition={{ duration: 0.3 }}
                  className="text-emerald-400 font-medium leading-relaxed bg-emerald-950/20 p-3 rounded-lg border border-emerald-500/20"
                >
                  {selectedAgent.liveOutput}
                </motion.p>
              </AnimatePresence>
            </div>

            <div className="border-t md:border-t-0 md:border-l border-white/10 pt-4 md:pt-0 md:pl-6 grid grid-cols-2 gap-4">
              {selectedAgent.metrics.map((m, idx) => (
                <div key={idx} className="space-y-1">
                  <span className="text-[11px] text-neutral-400 block">
                    {m.label}
                  </span>
                  <span className="text-lg font-bold font-mono text-neutral-100">
                    {m.val}
                  </span>
                </div>
              ))}
            </div>
          </div>
        </motion.div>
      </div>
    </section>
  );
}
